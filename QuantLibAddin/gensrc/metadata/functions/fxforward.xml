    <Constructor name='qlDiscountingFxForwardEngine'>
      <libraryFunction>DiscountingFxForwardEngine</libraryFunction>
      <SupportedPlatforms>
        <SupportedPlatform name='Excel'/>
        <SupportedPlatform name='Cpp'/>
      </SupportedPlatforms>
      <ParameterList>
        <Parameters>
          <Parameter name='SourceCcyDiscountCurve'>
            <type>QuantLib::YieldTermStructure</type>
            <superType>libToHandle</superType>
            <tensorRank>scalar</tensorRank>
            <description>Discount curve for the source currency.</description>
          </Parameter>
          <Parameter name='TargetCcyDiscountCurve'>
            <type>QuantLib::YieldTermStructure</type>
            <superType>libToHandle</superType>
            <tensorRank>scalar</tensorRank>
            <description>Discount curve for the target currency.</description>
          </Parameter>
          <Parameter name='SpotFx'>
            <type>QuantLib::Quote</type>
            <superType>libToHandle</superType>
            <tensorRank>scalar</tensorRank>
            <description>Spot FX rate quote (target currency per unit of source currency).</description>
          </Parameter>
        </Parameters>
      </ParameterList>
    </Constructor>

