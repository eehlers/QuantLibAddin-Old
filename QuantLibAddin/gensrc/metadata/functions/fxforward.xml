<Category name='fxforward'>
  <description>Functions to construct and use FxForward instruments and the DiscountingFxForwardEngine.</description>
  <displayName>FX Forward</displayName>
  <xlFunctionWizardCategory>QuantLib - Financial</xlFunctionWizardCategory>
  <serializationIncludes>
    <include>qlo/fxforward.hpp</include>
    <include>qlo/quote.hpp</include>
    <include>qlo/yieldtermstructures.hpp</include>
    <include>ql/instruments/fxforward.hpp</include>
    <include>ql/pricingengines/forward/discountingfxforwardengine.hpp</include>
  </serializationIncludes>
  <addinIncludes>
    <include>qlo/fxforward.hpp</include>
    <include>qlo/quote.hpp</include>
    <include>qlo/yieldtermstructures.hpp</include>
    <include>ql/instruments/fxforward.hpp</include>
    <include>ql/pricingengines/forward/discountingfxforwardengine.hpp</include>
  </addinIncludes>
  <copyright>
    Copyright (C) 2026
  </copyright>
  <Functions>

    <Constructor name='qlFxForward'>
      <libraryFunction>FxForward</libraryFunction>
      <SupportedPlatforms>
        <SupportedPlatform name='Excel'/>
        <SupportedPlatform name='Cpp'/>
      </SupportedPlatforms>
      <processorName>InstrumentProcessor</processorName>
      <ParameterList>
        <Parameters>
          <Parameter name='SourceNominal' exampleValue='1000000'>
            <type>double</type>
            <tensorRank>scalar</tensorRank>
            <description>Notional amount in source (domestic) currency.</description>
          </Parameter>
          <Parameter name='SourceCurrency' exampleValue='USD'>
            <type>QuantLib::Currency</type>
            <tensorRank>scalar</tensorRank>
            <description>Source currency (e.g. USD).</description>
          </Parameter>
          <Parameter name='TargetNominal' exampleValue='920000'>
            <type>double</type>
            <tensorRank>scalar</tensorRank>
            <description>Notional amount in target (foreign) currency.</description>
          </Parameter>
          <Parameter name='TargetCurrency' exampleValue='EUR'>
            <type>QuantLib::Currency</type>
            <tensorRank>scalar</tensorRank>
            <description>Target currency (e.g. EUR).</description>
          </Parameter>
          <Parameter name='MaturityDate' exampleValue='1Y'>
            <type>QuantLib::Date</type>
            <tensorRank>scalar</tensorRank>
            <description>Settlement / maturity date of the forward contract.</description>
          </Parameter>
          <Parameter name='PaySourceCurrency' exampleValue='true'>
            <type>bool</type>
            <tensorRank>scalar</tensorRank>
            <description>TRUE to pay source currency and receive target currency; FALSE for the opposite.</description>
          </Parameter>
          <Parameter name='SettlementDays' default='2'>
            <type>long</type>
            <tensorRank>scalar</tensorRank>
            <description>Number of business days for payment settlement (0=O/N, 1=T/N, 2=Spot).</description>
          </Parameter>
          <Parameter name='PaymentCalendar' default='"NullCalendar"'>
            <type>QuantLib::Calendar</type>
            <tensorRank>scalar</tensorRank>
            <description>Calendar used to advance the settlement date.</description>
          </Parameter>
        </Parameters>
      </ParameterList>
    </Constructor>

